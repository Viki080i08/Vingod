# ==========================================================================
# Trading AI Telegram Bot - Environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file. It is git-ignored on purpose.
# ==========================================================================

# --- Telegram (REQUIRED) --------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Comma separated list of Telegram user IDs that are treated as admins.
# Admins bypass rate limits and can use admin-only commands.
ADMIN_USER_IDS=

# Optional: broadcast automatic signal alerts to this chat id (channel/group/user).
# Leave empty to only send alerts to users who subscribed with /signaux.
ALERTS_CHAT_ID=

# --- Market data providers (OPTIONAL) -------------------------------------
# Crypto works out of the box using Binance public API (no key needed).
#
# For forex / stocks / indices you can provide ONE of the following keys.
# If none are provided, non-crypto assets return a graceful "no data" message.

# https://twelvedata.com  (free tier available)
TWELVE_DATA_API_KEY=

# https://www.alphavantage.co  (free tier available)
ALPHA_VANTAGE_API_KEY=

# --- News provider (OPTIONAL) ---------------------------------------------
# If empty, the bot falls back to public RSS feeds (no key required).
# https://newsapi.org
NEWS_API_KEY=

# --- Behaviour tuning (OPTIONAL) ------------------------------------------
# Minimum AI score (0-100) required to emit an automatic signal alert.
SIGNAL_MIN_SCORE=70

# How often (in seconds) the background scanner looks for opportunities.
SCAN_INTERVAL_SECONDS=900

# Per-user command rate limit (messages allowed inside the window).
RATE_LIMIT_MAX_CALLS=20
RATE_LIMIT_WINDOW_SECONDS=60

# SQLite database path.
DATABASE_PATH=trading_bot.db

# Default watchlist scanned by the background engine (comma separated).
DEFAULT_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
