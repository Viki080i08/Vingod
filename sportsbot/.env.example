# ============================================================
#  PronoIA - Bot Telegram de pronostics sportifs premium
#  Copiez ce fichier en `.env` et renseignez vos valeurs.
# ============================================================

# --- Telegram ---
# Token fourni par @BotFather. NE JAMAIS commiter ce token.
TELEGRAM_BOT_TOKEN=123456789:CHANGE_ME

# Liste d'IDs Telegram administrateurs separes par des virgules.
# Pour connaitre votre ID, envoyez /start au bot puis /whoami.
ADMIN_IDS=123456789

# --- Paiements Telegram ---
# Jeton du fournisseur de paiement (BotFather -> Payments).
# Laissez vide pour activer le mode "demo" (factures sans debit reel).
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
SUBSCRIPTION_PRICE_EUR=19.99
SUBSCRIPTION_CURRENCY=EUR
SUBSCRIPTION_DURATION_DAYS=30

# --- Base de donnees ---
# PostgreSQL recommande en production :
# DATABASE_URL=postgresql+psycopg2://prono:prono@localhost:5432/prono
# Par defaut, SQLite est utilise pour un demarrage immediat sans serveur DB.
DATABASE_URL=sqlite:///pronoia.db

# --- Fournisseur de donnees sportives ---
# "demo"  -> generateur interne realiste (aucune cle requise, marche hors-ligne)
# "footballdata" -> API football-data.org (cle gratuite requise)
DATA_PROVIDER=demo
FOOTBALL_DATA_API_KEY=
# Nombre de jours de matchs a charger (aujourd'hui + N-1). Max 5.
FORECAST_HORIZON_DAYS=5

# --- Taches programmees (heures locales serveur, format HH:MM) ---
DAILY_SYNC_TIME=06:00
DAILY_PUSH_TIME=09:00
RESULTS_UPDATE_TIME=23:30

# --- Dashboard administrateur (web) ---
ADMIN_WEB_HOST=0.0.0.0
ADMIN_WEB_PORT=8080
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD=changeme
ADMIN_WEB_SECRET=please-change-this-secret-key

# --- Divers ---
TIMEZONE=Europe/Paris
LOG_LEVEL=INFO
